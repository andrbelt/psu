{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Данные веб-формы «Помощник абитуриента ПГНИУ»",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "metadata": {
      "type": "object",
      "properties": {
        "prototype": {
          "type": "boolean"
        },
        "admissionYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "resultYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "resultsSource": {
          "type": "object",
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "asOf": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "fileName",
            "asOf"
          ],
          "additionalProperties": false
        },
        "demoFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "prototype",
        "admissionYear",
        "resultYear",
        "resultsSource",
        "demoFields"
      ],
      "additionalProperties": false
    },
    "catalogs": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "levels": {
          "type": "object",
          "properties": {
            "bachelor": {
              "type": "string",
              "minLength": 1
            },
            "specialist": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "bachelor",
            "specialist"
          ],
          "additionalProperties": false
        },
        "studyModes": {
          "type": "object",
          "properties": {
            "fullTime": {
              "type": "string",
              "minLength": 1
            },
            "partTime": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fullTime",
            "partTime"
          ],
          "additionalProperties": false
        },
        "fundingTypes": {
          "type": "object",
          "properties": {
            "budget": {
              "type": "string",
              "minLength": 1
            },
            "paid": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "budget",
            "paid"
          ],
          "additionalProperties": false
        },
        "faculties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects",
        "levels",
        "studyModes",
        "fundingTypes",
        "faculties"
      ],
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "properties": {
        "requiredSubjectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minOtherSubjects": {
          "type": "integer",
          "minimum": 0
        },
        "maxOtherSubjects": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "type": "object",
          "properties": {
            "hasPaidPlaces": {
              "type": "boolean"
            },
            "studyModes": {
              "type": "array",
              "items": {
                "enum": [
                  "fullTime",
                  "partTime"
                ]
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "facultyIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "hasPaidPlaces",
            "studyModes",
            "facultyIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "requiredSubjectIds",
        "minOtherSubjects",
        "maxOtherSubjects",
        "filters"
      ],
      "additionalProperties": false
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "competitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/competition"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "admissionResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "metadata",
    "catalogs",
    "form",
    "programs",
    "offers",
    "competitions",
    "admissionResults"
  ],
  "additionalProperties": false,
  "$defs": {
    "program": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "directionCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}$"
        },
        "directionTitle": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "bachelor",
            "specialist"
          ]
        },
        "searchAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "facultyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "directionCode",
        "directionTitle",
        "level",
        "searchAliases",
        "facultyIds"
      ],
      "additionalProperties": false
    },
    "tuition": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "RUB"
        },
        "period": {
          "const": "academicYear"
        },
        "academicYear": {
          "type": "string",
          "pattern": "^\\d{4}/\\d{4}$"
        },
        "status": {
          "enum": [
            "demo",
            "confirmed"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "period",
        "academicYear",
        "status"
      ],
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "programId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "admissionYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "studyMode": {
          "enum": [
            "fullTime",
            "partTime"
          ]
        },
        "competitionIds": {
          "type": "object",
          "properties": {
            "budget": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "paid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "budget",
            "paid"
          ],
          "additionalProperties": false
        },
        "tuition": {
          "anyOf": [
            {
              "$ref": "#/$defs/tuition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "programId",
        "admissionYear",
        "studyMode",
        "competitionIds",
        "tuition"
      ],
      "additionalProperties": false
    },
    "competition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "admissionYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "funding": {
          "enum": [
            "budget",
            "paid"
          ]
        },
        "scope": {
          "enum": [
            "offer",
            "group"
          ]
        },
        "plannedPlaces": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "demo",
            "confirmed",
            "unknown"
          ]
        },
        "examRequirements": {
          "anyOf": [
            {
              "$ref": "#/$defs/examRequirements"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "admissionYear",
        "funding",
        "scope",
        "plannedPlaces",
        "status",
        "examRequirements"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "plannedPlaces": {
            "anyOf": [
              {
                "const": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "examRequirements": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "examRequirements": {
            "$ref": "#/$defs/examRequirements"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "offerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "funding": {
          "enum": [
            "budget",
            "paid"
          ]
        },
        "scope": {
          "enum": [
            "offer",
            "group"
          ]
        },
        "enrolledCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "passingScore": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "maxScore": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "reported",
            "dashInSource",
            "scoreNotReported"
          ]
        },
        "sourcePage": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "offerIds",
        "year",
        "funding",
        "scope",
        "enrolledCount",
        "passingScore",
        "maxScore",
        "status",
        "sourcePage"
      ],
      "additionalProperties": false
    },
    "examRequirements": {
      "type": "object",
      "description": "Порядок строк карточки: primary, choice, russian.",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ege"
            },
            "subjectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$",
              "not": {
                "const": "russian"
              }
            },
            "minScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "type",
            "subjectId",
            "minScore"
          ],
          "additionalProperties": false,
          "description": "Основной обязательный предмет."
        },
        "choice": {
          "type": "array",
          "description": "Для поступления достаточно одного из перечисленных экзаменов.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "ege"
                  },
                  "subjectId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]+$",
                    "not": {
                      "const": "russian"
                    }
                  },
                  "minScore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "type",
                  "subjectId",
                  "minScore"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "dvi"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minScore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "type",
                  "title",
                  "minScore"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "russian": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ege"
            },
            "subjectId": {
              "const": "russian"
            },
            "minScore": {
              "const": 40
            }
          },
          "required": [
            "type",
            "subjectId",
            "minScore"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "primary",
        "choice",
        "russian"
      ],
      "additionalProperties": false
    }
  }
}
